# Copy to .env.local and fill in. Both values are public (inlined into the client bundle).

# Formspree form ID (the part after https://formspree.io/f/).
# Leave empty and the contact form falls back to opening the visitor's mail app.
NEXT_PUBLIC_FORMSPREE_ID=

# Sub-path the site is served from. GitHub Pages project sites need "/<repo>";
# the deploy workflow sets this automatically. Leave empty for local dev or a custom domain.
NEXT_PUBLIC_BASE_PATH=
