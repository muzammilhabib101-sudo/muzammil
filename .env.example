# Copy to .env.local and fill in. On Vercel, add these under Project → Settings → Environment Variables.

# ---- Server-only (never exposed to the browser) ----

# Gemini API key for the AI assistant. Create one at https://aistudio.google.com/apikey
# If missing, the chat widget still renders but replies with an error.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Gemini model for the assistant (defaults to gemini-3.8-flash).
GEMINI_MODEL=

# SMTP for the contact form (Nodemailer). Example for Gmail: host smtp.gmail.com, port 465,
# user = your Gmail address, pass = a Google "App password" (not your normal password).
SMTP_HOST=
# 465 = implicit TLS, 587 = STARTTLS (default 587).
SMTP_PORT=
# Optional: "true"/"false". Defaults to true on port 465, false otherwise.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Optional: sender address (defaults to SMTP_USER; must be allowed by your SMTP account).
CONTACT_FROM_EMAIL=
# Optional: inbox that receives contact messages (defaults to the email in lib/site.ts).
CONTACT_TO_EMAIL=

# ---- Public (inlined into the client bundle) ----

# Canonical site URL, e.g. https://muzammil.dev. On Vercel it defaults to the production domain.
NEXT_PUBLIC_SITE_URL=

# Sub-path the site is served from. Leave empty on Vercel or a custom domain.
NEXT_PUBLIC_BASE_PATH=
